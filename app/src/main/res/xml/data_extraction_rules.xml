        <include domain="database" path="historical_routines.db"/>
        <include domain="sharedpref" path="app_settings.xml"/>
        <include domain="sharedpref" path="routine_state_v1.xml"/>
        <include domain="sharedpref" path="first_run_guide.xml"/>
