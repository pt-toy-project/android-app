<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="12dp" android:paddingTop="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/routine_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="22sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" />
            <TextView android:id="@+id/routine_date" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
        <ImageButton android:id="@+id/iv_calendar" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/ic_calendar" android:contentDescription="@string/routine_choose_date"
            android:background="?attr/selectableItemBackgroundBorderless" app:tint="?android:attr/textColorPrimary" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="20dp" android:text="@string/routine_sample_notice" android:textColor="?android:attr/textColorSecondary" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_date_selector"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_routine_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" />
    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
