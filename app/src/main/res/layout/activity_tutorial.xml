<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ui_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="24dp" android:paddingEnd="12dp" android:paddingTop="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textAppearance="?attr/textAppearanceTitleMedium" android:textStyle="bold"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/intro_skip" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/intro_skip"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/intro_step" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="@color/ui_primary"/>
            <TextView android:id="@+id/intro_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textAppearance="?attr/textAppearanceHeadlineLarge" android:textStyle="bold"/>
            <TextView android:id="@+id/intro_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="?attr/textAppearanceBodyLarge"/>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.HeroDay.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" app:cardBackgroundColor="@color/ui_primary_container" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/intro_portrait" android:layout_width="56dp" android:layout_height="56dp" android:contentDescription="@null" app:shapeAppearanceOverlay="@style/ShapeAppearance.HeroDay.Avatar"/>
                    <TextView android:id="@+id/intro_demo_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:layout_marginTop="16dp"/>
                    <TextView android:id="@+id/intro_demo_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="20dp" android:paddingTop="12dp">
        <TextView android:id="@+id/intro_account_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:layout_marginBottom="8dp" android:accessibilityLiveRegion="polite"/>
        <com.google.android.gms.common.SignInButton android:id="@+id/intro_google" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" app:buttonSize="wide" app:colorScheme="light"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/intro_next" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:text="@string/intro_guest"/>
    </LinearLayout>
</LinearLayout>
