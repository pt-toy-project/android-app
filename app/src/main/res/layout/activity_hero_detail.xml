<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ui_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/screen_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" app:title="@string/redesign_preview"/>
    <TextView android:id="@+id/heroDetailError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyLarge" android:text="@string/hero_not_found" android:visibility="gone" android:padding="24dp"/>
    <androidx.core.widget.NestedScrollView android:id="@+id/heroDetailContent" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.card.MaterialCardView style="@style/Widget.HeroDay.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/heroDetailPortrait" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/ShapeAppearance.HeroDay.Avatar" android:contentDescription="@null"/>
                    <TextView android:id="@+id/heroDetailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineMedium" android:layout_marginTop="16dp" android:textStyle="bold"/>
                    <TextView android:id="@+id/heroDetailField" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/hero_day_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelLarge" android:text="@string/redesign_eight_blocks" android:layout_marginTop="12dp" android:textColor="@color/ui_primary"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/hero_about" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/redesign_hero_about"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/heroDetailBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
            <LinearLayout android:id="@+id/historicalRoutineContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/hero_credit" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/redesign_credit"/>
            <TextView android:id="@+id/heroPortraitCredit" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:visibility="gone"/>
            <TextView android:id="@+id/heroStorageError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:text="@string/hero_load_error" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/heroStorageRetry" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/hero_retry" android:visibility="gone"/>
            <TextView android:id="@+id/heroDetailAlarmStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:text="@string/hero_alarm_restore_error" android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/hero_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="12dp" android:background="@color/ui_surface">
        <com.google.android.material.button.MaterialButton android:id="@+id/heroPersonalRoutines" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/day_start"/>
    </LinearLayout>
</LinearLayout>
