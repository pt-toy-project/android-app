<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
        <TimePicker android:id="@+id/personal_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:timePickerMode="spinner" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_repeat_days" />
        <LinearLayout android:id="@+id/personal_weekdays" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/personal_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/personal_enabled" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/personal_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/personal_alarm" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/personal_alarm_hint" />
    </LinearLayout>
</ScrollView>
