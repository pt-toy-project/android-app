<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 화면 내용이 들어가는 구역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginBottom="60dp"> <!-- 💡 하단 바에 버튼이 가려지지 않게 여백 추가 -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="위인 선택"
            android:textSize="28sp" />

        <ImageView
            android:id="@+id/ivSejongCharacter"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/sesong"
            android:scaleType="fitCenter"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnSejong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="세종대왕"
            android:layout_marginTop="32dp" />

        <Button
            android:id="@+id/btnYiSunSin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이순신"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnEinstein"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="아인슈타인"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- 하단 네비게이션 바 -->
    <include layout="@layout/layout_bottom_nav" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>