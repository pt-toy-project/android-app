<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/ui_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/screen_toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="56dp" app:title="@string/timetable_title"/>
    <androidx.core.widget.NestedScrollView android:id="@+id/timetable_scroll"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:id="@+id/timetable_content" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:id="@+id/timetable_view_hint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"/>
            <com.google.android.material.chip.ChipGroup android:id="@+id/timetable_view_modes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.chip.Chip android:id="@+id/timetable_week_mode"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checkable="true" android:minHeight="48dp" android:text="@string/timetable_week_view"/>
                <com.google.android.material.chip.Chip android:id="@+id/timetable_list_mode"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checkable="true" android:minHeight="48dp" android:text="@string/timetable_list_view"/>
            </com.google.android.material.chip.ChipGroup>
            <TextView android:id="@+id/timetable_summary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/ui_text" android:textStyle="bold"/>
            <TextView android:id="@+id/timetable_next_class" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:padding="12dp" android:background="@color/ui_primary_container"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/ui_on_container"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/timetable_add"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/timetable_add"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/timetable_everytime"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:layout_marginStart="8dp" android:text="@string/timetable_everytime"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/timetable_repeat"
                android:textAppearance="?attr/textAppearanceBodySmall"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/timetable_widget_add"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:minHeight="52dp"
                android:text="@string/timetable_widget_add"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/timetable_notification_heading"
                android:textAppearance="?attr/textAppearanceTitleLarge" android:textStyle="bold"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/timetable_notice_toggle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:text="@string/timetable_notice_on"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/timetable_notice_settings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/timetable_notice_settings"
                android:visibility="gone"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="@string/timetable_files"
                android:textAppearance="?attr/textAppearanceTitleLarge" android:textStyle="bold"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/timetable_import"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="52dp" android:text="@string/timetable_csv_import"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/timetable_export"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/timetable_csv_export"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/timetable_csv_help" android:textAppearance="?attr/textAppearanceBodySmall"/>
            <TextView android:id="@+id/timetable_status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:accessibilityLiveRegion="polite"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/layout_bottom_nav"/>
</LinearLayout>
