<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp"
    android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground"
    android:clickable="true" android:focusable="true" android:orientation="horizontal">
    <TextView android:id="@+id/tv_time" android:layout_width="64dp" android:layout_height="wrap_content"
        android:textSize="14sp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/tv_routine_title" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="16sp" android:textColor="?android:attr/textColorPrimary"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/tv_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:textSize="12sp" android:importantForAccessibility="no" />
</LinearLayout>
