<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="52dp" android:layout_height="wrap_content" android:minHeight="72dp"
    android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center"
    android:orientation="vertical" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tv_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/tv_day_number" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="18sp" android:textStyle="bold" android:importantForAccessibility="no" />
    <TextView android:id="@+id/tv_day_week" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:importantForAccessibility="no" />
</LinearLayout>
