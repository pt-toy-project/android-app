<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hero_add_dialog_notice"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/historicalTimePicker"
            style="?attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hero_weekday_heading"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout
            android:id="@+id/historicalWeekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/historicalWeekdayError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/hero_weekday_required"
            android:textColor="?attr/colorError"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
