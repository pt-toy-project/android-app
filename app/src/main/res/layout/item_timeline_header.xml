<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="8dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/personal_create" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/redesign_add_plan" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/routine_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textStyle="bold"/>
            <TextView android:id="@+id/routine_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/iv_calendar" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/redesign_date" app:icon="@drawable/ic_calendar"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_date_selector" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:nestedScrollingEnabled="false"/>
    <com.google.android.material.card.MaterialCardView style="@style/Widget.HeroDay.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/ui_primary_container">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/day_badge" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelLarge"/>
            <TextView android:id="@+id/personal_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textStyle="bold"/>
            <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/timeline_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" app:trackThickness="6dp" app:trackCornerRadius="3dp"/>
            <TextView android:id="@+id/timeline_wallet" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.chip.ChipGroup android:id="@+id/timeline_heroes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:singleSelection="true" app:selectionRequired="true"/>
    <com.google.android.material.card.MaterialCardView style="@style/Widget.HeroDay.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:id="@+id/timeline_next_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:id="@+id/next_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceLabelLarge" android:text="@string/redesign_next"/>
            <TextView android:id="@+id/timeline_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge" android:layout_marginTop="8dp"/>
            <TextView android:id="@+id/timeline_next_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:layout_marginTop="4dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/timeline_next_complete" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/timeline_complete"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/Widget.HeroDay.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:id="@+id/timeline_empty_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/today_hero_portrait" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@null" app:shapeAppearanceOverlay="@style/ShapeAppearance.HeroDay.Avatar"/>
            <TextView android:id="@+id/empty_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge" android:text="@string/redesign_empty_day" android:layout_marginTop="12dp"/>
            <TextView android:id="@+id/personal_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:text="@string/redesign_empty_subtitle" android:layout_marginTop="8dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/empty_start" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/redesign_choose_day"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:id="@+id/day_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:text="@string/day_notice" android:layout_marginBottom="12dp"/>
    <TextView android:id="@+id/personal_alarm_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:accessibilityLiveRegion="polite"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/timeline_section" android:layout_width="0dp" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:text="@string/redesign_timeline" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/personal_manage" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/redesign_manage"/>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/personal_add" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/redesign_choose_day"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/personal_history" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/personal_history"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/day_settings" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/nav_settings"/>
    </LinearLayout>
</LinearLayout>
