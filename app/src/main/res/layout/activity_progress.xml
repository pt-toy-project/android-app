<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ui_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/screen_toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" app:title="@string/progress_title"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/progress_heading" android:textAppearance="?attr/textAppearanceHeadlineLarge" android:textStyle="bold" android:layout_marginTop="16dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/progress_body" android:textAppearance="?attr/textAppearanceBodyMedium" android:layout_marginTop="12dp"/>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.HeroDay.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
                <TextView android:id="@+id/progress_totals" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:textAppearance="?attr/textAppearanceTitleMedium" android:lineSpacingExtra="8dp" android:accessibilityLiveRegion="polite" android:text="@string/calendar_loading"/>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/progress_month_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="16dp" android:text="@string/progress_month_open"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/progress_badges" android:textAppearance="?attr/textAppearanceTitleLarge" android:textStyle="bold" android:layout_marginTop="32dp" android:layout_marginBottom="16dp"/>
            <LinearLayout android:id="@+id/progress_badges" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/progress_notice" android:textAppearance="?attr/textAppearanceBodySmall" android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
