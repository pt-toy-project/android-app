<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:id="@+id/evidence_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge"/>
        <com.google.android.material.chip.Chip android:id="@+id/evidence_grade" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="false" android:clickable="false"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quest_heading" android:textAppearance="?attr/textAppearanceTitleMedium" android:layout_marginTop="12dp"/>
        <LinearLayout android:id="@+id/evidence_quests" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/quest_read_only_note" android:textAppearance="?attr/textAppearanceBodySmall"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/evidence_toggle" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/quest_source_toggle"/>
        <LinearLayout android:id="@+id/evidence_citation_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/evidence_practice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/evidence_times" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:layout_marginTop="16dp"/>
        <TextView android:id="@+id/evidence_fact" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:layout_marginTop="16dp"/>
        <TextView android:id="@+id/evidence_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall" android:layout_marginTop="16dp" android:textIsSelectable="true"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/evidence_open" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/day_source_open"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
